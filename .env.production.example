# Copy to .env.production, replace every change-me value, and keep that file outside Git.
NODE_ENV=production
APP_URL=https://app.example.com
API_PORT=4000
CORS_ORIGINS=https://app.example.com

POSTGRES_PASSWORD=change-me-long-random-postgres-password
REDIS_PASSWORD=change-me-long-random-redis-password
MINIO_ROOT_USER=pulihkanaku
MINIO_ROOT_PASSWORD=change-me-long-random-minio-password

SESSION_SECRET=change-me-at-least-32-random-characters
OTP_SECRET=change-me-independent-32-random-characters
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
PAYOUT_ENCRYPTION_KEY=change-me-32-byte-base64url-key

# Keep disabled for infrastructure/staging validation. Set GO_LIVE=true only after all provider probes pass.
GO_LIVE=false
PAYOUT_PROVIDER=disabled
XENDIT_API_URL=https://api.xendit.co
XENDIT_SECRET_API_KEY=
XENDIT_WEBHOOK_TOKEN=
PAYOUT_PROVIDER_LICENSE_REFERENCE=

EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=PulihkanAku <no-reply@example.com>
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_HEALTH_URL=
NOTIFICATION_GATEWAY_TOKEN=

SENTRY_DSN=
METRICS_TOKEN=change-me-metrics-scrape-token
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
LOG_LEVEL=info
WORKER_CONCURRENCY=8
