# APP
NODE_ENV=development
APP_URL=http://localhost:3000
API_PREFIX=/api/v1
TZ=Asia/Jakarta

# DATABASE (production PostgreSQL adapter milestone)
DATABASE_URL=postgresql://pulihkanaku:pulihkanaku@localhost:5432/pulihkanaku
DATABASE_POOL_MAX=10

# REDIS
REDIS_URL=redis://localhost:6379

# AUTH / OTP
SESSION_SECRET=replace-with-at-least-32-random-characters
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SECRET=replace-with-independent-random-hmac-secret
PAYOUT_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
CRON_SECRET=replace-with-random-maintenance-secret

# STORAGE
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET_PRIVATE=pulihkanaku-private
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=replace-me

# PAYMENT / PAYOUT
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-me
PAYOUT_PROVIDER=mock
XENDIT_API_URL=https://api.xendit.co
XENDIT_SECRET_API_KEY=
XENDIT_WEBHOOK_TOKEN=
PAYOUT_PROVIDER_LICENSE_REFERENCE=
GO_LIVE=false

# NOTIFICATIONS
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
SMS_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=PulihkanAku <no-reply@example.com>
NOTIFICATION_GATEWAY_URL=
NOTIFICATION_GATEWAY_HEALTH_URL=
NOTIFICATION_GATEWAY_TOKEN=

# MALWARE SCANNING
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# SECURITY / OBSERVABILITY
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
SENTRY_DSN=
FEATURE_INCOME_PLAN=false
