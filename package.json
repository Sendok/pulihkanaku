{
  "name": "pulihkanaku",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --experimental-strip-types --test tests/domain.test.mjs tests/service-contract.test.mjs tests/deployment-tools.test.mjs",
    "test:integration": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:e2e": "npm run dev:setup && node --test tests/e2e-contract.test.mjs",
    "test:service": "node --test tests/service-integration.mjs",
    "test:production-smoke": "node tests/production-smoke.mjs",
    "test:external-stack": "scripts/test-external-stack.sh",
    "validate:production-env": "node --env-file=.env.production scripts/validate-production-env.mjs",
    "probe:providers": "node --env-file=.env.production scripts/provider-preflight.mjs",
    "test:provider-send": "node --env-file=.env.production scripts/send-provider-test.mjs",
    "deploy:self-host": "scripts/deploy-production.sh",
    "build:services": "corepack pnpm --filter @pulihkanaku/config build && corepack pnpm --filter @pulihkanaku/database build && corepack pnpm --filter @pulihkanaku/api build && corepack pnpm --filter @pulihkanaku/worker build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern 'apps/**/dist' --ignore-pattern 'packages/**/dist' --ignore-pattern .next --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state --config wrangler.local.jsonc",
    "dev:setup": "npm run db:migrate:local"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "turbo": "^2.5.0",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
